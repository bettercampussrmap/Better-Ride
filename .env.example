# Better Campus - Travel Buddy Finder (SRM University-AP)
# Supabase Configuration

# 1. Your Supabase Project URL (found in Supabase Dashboard > Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co

# 2. Your Supabase API Key (found in Supabase Dashboard > Project Settings > API > Project API keys)
# Provide either NEXT_PUBLIC_SUPABASE_ANON_KEY (legacy format) or NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY (new format)
NEXT_PUBLIC_SUPABASE_ANON_KEY=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=

# Note for Google OAuth:
# Do NOT place Google Client ID or Secret here. 
# Configure them directly in Supabase Dashboard > Authentication > Providers > Google.
